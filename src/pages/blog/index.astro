---
import { getCollection } from 'astro:content';
import Footer from '../../components/layout/Footer.astro';
import Navbar from '../../components/layout/Navbar.astro';
import { formatTanggalIndonesia } from '../../lib/format';
import { getSiteSettingsContent } from '../../lib/site-content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog')).sort(
  (left, right) => right.data.tanggal.valueOf() - left.data.tanggal.valueOf()
);
const siteSettings = getSiteSettingsContent();
---

<BaseLayout title="Blog" description={siteSettings.publicText.blogSubtitle}>
  <Navbar />
  <main id="konten" class="blog-page">
    <section class="content-section">
      <div class="shell blog-header reveal is-visible">
        <p class="eyebrow">{siteSettings.publicText.blogTitle}</p>
        <h1>{siteSettings.publicText.blogTitle}</h1>
        <p class="lead-small">{siteSettings.publicText.blogSubtitle}</p>
      </div>
    </section>

    <section class="content-section blog-listing">
      <div class="shell blog-grid">
        {
          posts.map((post) => (
            <article class="blog-card reveal is-visible">
              <p class="blog-meta">
                {formatTanggalIndonesia(post.data.tanggal)} · {post.data.penulis}
              </p>
              <h2>{post.data.judul}</h2>
              <p>{post.data.ringkasan}</p>
              <a href={`/blog/${post.id}`}>{siteSettings.publicText.blogReadMore}</a>
            </article>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
