---
import Footer from '../components/layout/Footer.astro';
import Navbar from '../components/layout/Navbar.astro';
import HeroCarousel from '../components/sections/HeroCarousel.astro';
import ProfilKetua from '../components/sections/ProfilKetua.astro';
import SejarahGereja from '../components/sections/SejarahGereja.astro';
import StatistikJemaat from '../components/sections/StatistikJemaat.astro';
import StrukturOrganisasi from '../components/sections/StrukturOrganisasi.astro';
import VisiMisi from '../components/sections/VisiMisi.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Navbar />
  <main id="konten">
    <HeroCarousel />
    <ProfilKetua />
    <StrukturOrganisasi />
    <SejarahGereja />
    <VisiMisi />
    <StatistikJemaat />
  </main>
  <Footer />

  <script is:inline>
    const revealItems = Array.from(document.querySelectorAll('.reveal'));
    const revealObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.18 }
    );

    for (const item of revealItems) revealObserver.observe(item);

    const slides = Array.from(document.querySelectorAll('[data-slide]'));
    const dots = Array.from(document.querySelectorAll('[data-dot]'));
    let activeIndex = 0;

    const syncCarousel = (index) => {
      slides.forEach((slide, slideIndex) => {
        slide.dataset.active = slideIndex === index ? 'true' : 'false';
      });
      dots.forEach((dot, dotIndex) => {
        dot.dataset.active = dotIndex === index ? 'true' : 'false';
      });
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        activeIndex = index;
        syncCarousel(activeIndex);
      });
    });

    if (slides.length > 1) {
      window.setInterval(() => {
        activeIndex = (activeIndex + 1) % slides.length;
        syncCarousel(activeIndex);
      }, 4000);
    }

    const timeline = document.querySelector('[data-history]');
    const spineFill = document.querySelector('[data-history-spine-fill]');

    const updateSpine = () => {
      if (!timeline || !spineFill) return;
      const rect = timeline.getBoundingClientRect();
      const viewportHeight = window.innerHeight;
      const progress = Math.min(
        1,
        Math.max(0, (viewportHeight * 0.7 - rect.top) / Math.max(rect.height, 1))
      );
      spineFill.style.height = `${progress * 100}%`;
    };

    updateSpine();
    window.addEventListener('scroll', updateSpine, { passive: true });
    window.addEventListener('resize', updateSpine);
  </script>
</BaseLayout>
