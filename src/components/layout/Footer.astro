---
import { getSiteSettingsContent } from '../../lib/site-content';

const siteSettings = getSiteSettingsContent();
---

<footer class="site-footer" id="footer">
  <div class="shell footer-grid reveal">
    <div class="footer-copy">
      <p class="eyebrow">{siteSettings.publicText.footerTitle}</p>
      <h2>{siteSettings.namaGereja}</h2>
      <p>{siteSettings.publicText.footerPrayer}</p>
    </div>

    <dl class="footer-meta">
      <div>
        <dt>{siteSettings.publicText.footerAddress}</dt>
        <dd>{siteSettings.alamat}</dd>
      </div>
      <div>
        <dt>{siteSettings.publicText.footerPhone}</dt>
        <dd>
          <a href={`tel:${siteSettings.telepon}`}>{siteSettings.telepon}</a>
        </dd>
      </div>
      <div>
        <dt>{siteSettings.publicText.footerEmail}</dt>
        <dd>
          <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
        </dd>
      </div>
    </dl>
  </div>
</footer>
