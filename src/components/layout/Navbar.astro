---
import { getSiteSettingsContent } from '../../lib/site-content';

const siteSettings = getSiteSettingsContent();
---

<header class="site-header">
  <div class="shell nav-shell">
    <a class="brand" href="/">
      <span class="nav-cross" aria-hidden="true"></span>
      <span class="brand-copy">
        <strong>{siteSettings.namaGereja}</strong>
        <small>{siteSettings.tagline}</small>
      </span>
    </a>

    <nav aria-label={siteSettings.publicText.menuLabel}>
      <ul class="nav-list">
        {
          siteSettings.navLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
