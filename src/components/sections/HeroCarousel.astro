---
import { liturgiThemes } from '../../config/liturgi.config';
import {
  getCarouselContent,
  getPengaturanContent,
  getSiteSettingsContent,
} from '../../lib/site-content';

const slides = getCarouselContent();
const pengaturan = getPengaturanContent();
const siteSettings = getSiteSettingsContent();
const activeTheme = liturgiThemes[pengaturan.masaLiturgi] ?? liturgiThemes.biasa;
---

<section class="hero" data-carousel>
  <div class="hero-slides" data-slide-track>
    {
      slides.map((slide, index) => (
        <article
          class="hero-slide"
          data-slide
          data-active={index === 0 ? 'true' : 'false'}
          style={slide.gambar ? `--hero-image: url(${slide.gambar});` : undefined}
        >
          <svg
            class="slide-pattern"
            viewBox="0 0 800 520"
            preserveAspectRatio="xMidYMid slice"
            aria-hidden="true"
          >
            <defs>
              <pattern id={`pg${index}`} patternUnits="userSpaceOnUse" width="80" height="80">
                <path d="M40 10 L40 70 M10 40 L70 40" />
                <circle cx="40" cy="40" r="20" />
              </pattern>
            </defs>
            <rect width="800" height="520" fill={`url(#pg${index})`} />
          </svg>
          <div class="hero-overlay" aria-hidden="true"></div>
          <div class="shell hero-copy">
            <p class="eyebrow">{siteSettings.publicText.heroBadge}</p>
            <h1>{siteSettings.namaGereja}</h1>
            <p class="hero-sub">{siteSettings.tagline}</p>
            <p class="hero-caption">{slide.judul} - {slide.subjudul}</p>
            {!slide.gambar && <p class="hero-theme">{activeTheme.label}</p>}
          </div>
        </article>
      ))
    }
  </div>

  <div class="shell hero-ui">
    <div class="hero-dots" aria-label="Navigasi carousel">
      {
        slides.map((slide, index) => (
          <button
            type="button"
            class="hero-dot"
            data-dot
            data-active={index === 0 ? 'true' : 'false'}
            aria-label={slide.judul}
          />
        ))
      }
    </div>
  </div>
</section>
