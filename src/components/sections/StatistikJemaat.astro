---
import { siteConfig } from '../../config/site.config';
import { getStatistikContent } from '../../lib/site-content';

const statistik = getStatistikContent();
---

<section class="content-section surface-section">
  <div class="shell reveal">
    <div class="section-heading">
      <p class="eyebrow">{siteConfig.publicText.statistikEyebrow}</p>
      <h2>{siteConfig.publicText.statistikTitle}</h2>
    </div>

    <div class="stats-grid">
      {
        statistik.map((item) => (
          <article class="stat-card">
            <p>{item.label}</p>
            <strong>{item.angka}</strong>
            <span>{item.keterangan}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>
