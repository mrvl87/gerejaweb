---
import { getSiteSettingsContent, getVisiMisiContent } from '../../lib/site-content';

const visiMisi = getVisiMisiContent();
const siteSettings = getSiteSettingsContent();
---

<section class="content-section">
  <div class="shell vision-grid reveal">
    <div class="vision-panel">
      <p class="eyebrow">{siteSettings.publicText.visiEyebrow}</p>
      <h2>{siteSettings.publicText.visiTitle}</h2>
      <p class="lead-small">{visiMisi.visi}</p>
    </div>

    <div class="mission-panel">
      <h2>{siteSettings.publicText.misiTitle}</h2>
      <ol class="mission-list">
        {visiMisi.misi.map((item) => <li>{item}</li>)}
      </ol>
    </div>
  </div>
</section>
