---
import { getProfilKetuaContent, getSiteSettingsContent } from '../../lib/site-content';

const profil = getProfilKetuaContent();
const siteSettings = getSiteSettingsContent();
---

<section class="content-section">
  <div class="shell profile-grid reveal">
    <div class="profile-visual">
      {
        profil.foto ? (
          <img src={profil.foto} alt={profil.nama} loading="lazy" />
        ) : (
          <div class="image-fallback image-fallback-profile">{profil.nama}</div>
        )
      }
    </div>

    <div class="profile-copy">
      <p class="eyebrow">{siteSettings.publicText.profilEyebrow}</p>
      <h2>{profil.nama}</h2>
      <p class="profile-role">{profil.jabatan}</p>
      <p class="profile-subtitle">{profil.subJudul}</p>
      <p>{profil.biografi}</p>
      <blockquote>{profil.kutipan}</blockquote>
    </div>
  </div>
</section>
