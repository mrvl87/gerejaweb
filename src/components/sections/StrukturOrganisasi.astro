---
import { siteConfig } from '../../config/site.config';
import { cn } from '../../lib/format';
import { getStrukturOrganisasiContent } from '../../lib/site-content';

const struktur = getStrukturOrganisasiContent();
const groupedLevels = Object.entries(
  struktur.reduce<Record<string, typeof struktur>>((accumulator, item) => {
    const key = String(item.level);
    accumulator[key] ??= [];
    accumulator[key].push(item);
    return accumulator;
  }, {})
);
---

<section class="content-section surface-section" id="struktur">
  <div class="shell reveal">
    <div class="section-heading">
      <p class="eyebrow">{siteConfig.publicText.strukturEyebrow}</p>
      <h2>{siteConfig.publicText.strukturTitle}</h2>
    </div>

    <div class="structure-stack">
      {
        groupedLevels.map(([level, items]) => (
          <div class="structure-level">
            <span class="structure-level-label">Level {level}</span>
            <div class="structure-grid">
              {items.map((item) => (
                <article class={cn('structure-card', item.isMilestone && 'structure-card-milestone')}>
                  <p>{item.jabatan}</p>
                  <h3>{item.nama}</h3>
                </article>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
